    <profile id="d13e83bc-89c0-52b6-b930-74a802d0fc44" name="Psychoactive Crown" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a 4+ invulnerable save. Ezyrithn and his unit add +1 to Deny the Witch against Runes of Fate, Runes of Battle or Telepathy.</characteristic>
      </characteristics>
    </profile>
    <profile id="fcefeb71-274f-542d-af05-df98f5de798e" name="Sensory Veil" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Defensive Grenades; gains Stealth until the bearer has fired a weapon or charged in the current turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="116257c9-a87b-59af-b644-1412a7d4f2b9" name="Icon of Slaanesh" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Friendly non-Daemon, non-Horror units within 6" gain Stubborn and Fleet. Multiple Icons do not stack.</characteristic>
      </characteristics>
    </profile>
    <profile id="f73bb2e4-0088-5dd3-b18d-6cdfa0087817" name="Phantasm Mask" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Bearer has Fear. Enemy Characters in a Challenge with bearer suffer -1 Leadership.</characteristic>
      </characteristics>
    </profile>
    <profile id="9f7a10b4-13d2-503b-86ed-5f7ce662bbda" name="Clonefield" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At start of each Challenge roll D3; reduce enemy Character's Attacks by this amount for that Fight sub-phase, minimum 1.</characteristic>
      </characteristics>
    </profile>
    <profile id="81fbed42-a03d-5ca2-9bc1-2fe6087ca7d0" name="Flesh-stitcher Array" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">At end of Movement phase, attempt to restore one Wound to bearer or friendly Horror within 3"; 4+ restores one. A model may be targeted by only one Array per turn.</characteristic>
      </characteristics>
    </profile>
    <profile id="aa632871-c291-5223-a41f-5a53a723cb44" name="Shimmerfield" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Bearer gains 5+ invulnerable save, or improves existing invulnerable save by 1 to max 4+.</characteristic>
      </characteristics>
    </profile>
    <profile id="0fe87657-1622-55b7-b465-f95f3b91f358" name="Exalted Shimmerfield" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile id="627929df-4895-53b3-94d6-d1356a2b9208" name="Webway Breach Node" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">One use. At start of friendly Movement phase place marker in base contact. Friendly Shae'lait Infantry, Beast or Daemon units Deep Striking within 6" do not scatter that turn. Remove marker at end of phase.</characteristic>
      </characteristics>
    </profile>
    <profile id="d007a83d-7e08-5f20-8d04-b1a36368e762" name="Flickerfield" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
