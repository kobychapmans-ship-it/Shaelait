    <profile id="319dad86-1ac1-5a70-9412-f396a0b44afb" name="Sixfold crown" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Karakiethal's Six-fold Path is always one step higher than the normal game turn. At Step Six, instead of gaining Daemon of Slaanesh again, it gains +1 Attack.</characteristic>
      </characteristics>
    </profile>
    <profile id="8014032f-1bd8-510f-8ed3-3762866a9150" name="Webway Translation Engine" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">If purchased, the Titan may begin in Reserve and arrive by Deep Strike. If it scatters onto impassable terrain or another model, reduce scatter by the minimum distance needed to place it legally instead of rolling a Mishap.</characteristic>
      </characteristics>
    </profile>
